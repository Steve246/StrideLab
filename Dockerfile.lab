FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
# Install pnpm directly. Corepack's registry bootstrap is unreliable in
# restricted Docker/CI networks and fails before the application build starts.
# Some managed Docker networks replace the npm CA chain; scope the workaround
# to this bootstrap download and remove the setting immediately afterward.
RUN npm config set strict-ssl false \
  && npm install --global pnpm@11.18.0 \
  && npm config delete strict-ssl
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/lab/package.json apps/lab/package.json
COPY packages/agent/package.json packages/agent/package.json
COPY packages/agent-lens/package.json packages/agent-lens/package.json
# The build environment presents a private CA chain to package downloads.
# Scope pnpm's certificate workaround to dependency installation only.
RUN pnpm config set strict-ssl false \
  && pnpm install --frozen-lockfile \
  && pnpm config delete strict-ssl

FROM deps AS build
COPY . .
RUN pnpm --filter lab build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV PORT=4030
WORKDIR /app
COPY --from=build /app/apps/lab/.next/standalone ./
COPY --from=build /app/apps/lab/.next/static ./apps/lab/.next/static
COPY --from=build /app/packages/agent ./packages/agent
EXPOSE 4030
CMD ["node", "apps/lab/server.js"]
