FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.18.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/lab/package.json apps/lab/package.json
COPY packages/agent/package.json packages/agent/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm --filter lab build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV PORT=4030
WORKDIR /app
COPY --from=build /app/apps/lab/.next/standalone ./
COPY --from=build /app/apps/lab/.next/static ./apps/lab/.next/static
COPY --from=build /app/apps/lab/public ./apps/lab/public
COPY --from=build /app/packages/agent ./packages/agent
EXPOSE 4030
CMD ["node", "apps/lab/server.js"]
