OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key
TAVILY_API_KEY=your_tavily_api_key

# Chat model for the agent (must support function tools on /v1/chat/completions).
# Avoid gpt-5.6-terra here — it rejects tools unless using /v1/responses.
OPENAI_MODEL=gpt-4.1

# Absolute path to Garmin Connect export.
# Prefer the DI_CONNECT folder; a parent that contains DI_CONNECT also works.
# After setting this, restart Studio and say "sync" — no path needed in the prompt.
GARMIN_EXPORT_DIR=/path/to/DI_CONNECT

# Banister TRIMP athlete HR profile.
# Leave EMPTY to auto-fill from synced Garmin data:
#   ATHLETE_HR_REST ← median resting HR (last ~90 days of enrichment/daily.json)
#   ATHLETE_HR_MAX  ← ~95th percentile of activity max_hr (last ~180 days)
# Set a number here only when you want to override.
ATHLETE_HR_REST=
ATHLETE_HR_MAX=
ATHLETE_SEX=male
