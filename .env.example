# Which LLM backend the Lab + Anvia agent use: devscale | openai
LLM_PROVIDER=devscale

# --- Devscale AI gateway (OpenAI-compatible: https://gateway.devscale.id/v1)
# Docs: https://gateway.devscale.id/console/documentation
DEVSCALE_BASE_URL=https://gateway.devscale.id/v1
DEVSCALE_API_KEY=your_devscale_mux_sk_key
# Prefer a stable chat_completions model. gpt-5.6-luna is often 503 on the gateway.
DEVSCALE_MODEL=deepseek-v4-flash-0731
# Optional comma list tried after primary on 502/503
DEVSCALE_FALLBACK_MODELS=muse-spark-1.3-contributor,gpt-5.6-luna

# --- Coach chat verbosity
# Tool names, the tool catalog, and per-turn tool traces are hidden in
# production by default. Set true to reveal them (debugging), false to hide
# them even in development.
# COACH_SHOW_TOOLS=false

# --- Optional Anvia Lens observability (server-side only)
# Leave all three connection values empty to keep Lens disabled locally.
ANVIA_LENS_BASE_URL=http://localhost
ANVIA_LENS_PUBLIC_KEY=pk-lens-your-project-key
ANVIA_LENS_SECRET_KEY=sk-lens-your-project-key
ANVIA_LENS_SERVICE_NAME=stridelab-agent
ANVIA_LENS_ENVIRONMENT=local
ANVIA_LENS_RELEASE=

# --- Direct OpenAI (used when LLM_PROVIDER=openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1

TAVILY_API_KEY=your_tavily_api_key

# Absolute path to Garmin Connect export.
# Prefer the DI_CONNECT folder; a parent that contains DI_CONNECT also works.
# This stays the fallback default: the Lab UI can save a per-machine override
# without editing this file, and "Reset to .env" restores this value.
GARMIN_EXPORT_DIR=/path/to/DI_CONNECT

# Manual import is the default. Keep live Garmin private until the worker and
# authenticated deployment are ready.
GARMIN_LIVE_ENABLED=false

# --- External channels --------------------------------------------------
# MCP is the channel-agnostic capability layer (stdio by default). Telegram,
# Anvia Studio, Claude, Cursor, VS Code, Windsurf, Cline and Zed connect to it
# as interchangeable clients. Generate client config with: pnpm mcp:config
#
# Rename the advertised MCP server (default: stridelab-mcp).
# MCP_SERVER_NAME=stridelab-mcp
#
# Optional integration surfaces in the External panel (Telegram adapter and
# Anvia Lens/observability). Hidden in production by default; set true to show
# them in production, or false to hide them even in development.
# EXTERNAL_SHOW_INTEGRATIONS=false
#
# Public URL used in Telegram replies and the External panel.
LAB_PUBLIC_URL=http://localhost:4030

# Remote MCP transport (POST /api/mcp). Disabled unless explicitly enabled.
# When enabled, callers must send: Authorization: Bearer <token>.
MCP_HTTP_ENABLED=false
MCP_HTTP_AUTH_TOKEN=

# Telegram adapter (the first non-local MCP client). Fails closed without an
# explicit allowlist. Run it with: pnpm telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_PUBLIC_BOT_URL=

# Optional live Garmin Connect connector. Install it first from the repository root:
#   python3 -m pip install -e packages/garmin-connector
# Then enable it. The dashboard keeps manual export as a separate workflow.
# Optional override. If omitted, the backend runs the repository-local
# `.venv-garmin/bin/python -m garmin_connector` command automatically.
# GARMIN_CONNECTOR_COMMAND=garmin-connector

# Banister TRIMP athlete HR profile.
# Leave EMPTY to auto-fill from synced Garmin data.
ATHLETE_HR_REST=
ATHLETE_HR_MAX=
ATHLETE_SEX=male

# Local calendar for Daily Analyzer / activity day bucketing (IANA TZ).
ATHLETE_TIMEZONE=Asia/Jakarta
