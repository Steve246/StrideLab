# Which LLM backend the Lab + Anvia agent use: devscale | openai
LLM_PROVIDER=devscale

# --- Devscale AI gateway (OpenAI-compatible: https://gateway.devscale.id/v1)
# Docs: https://gateway.devscale.id/console/documentation
DEVSCALE_BASE_URL=https://gateway.devscale.id/v1
DEVSCALE_API_KEY=your_devscale_mux_sk_key
# Prefer a stable chat_completions model. gpt-5.6-luna is often 503 on the gateway.
DEVSCALE_MODEL=deepseek-v4-flash-0731
# Optional comma list tried after primary on 502/503
DEVSCALE_FALLBACK_MODELS=muse-spark-1.3-contributor,gpt-5.6-luna

# --- Direct OpenAI (used when LLM_PROVIDER=openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1

TAVILY_API_KEY=your_tavily_api_key

# Absolute path to Garmin Connect export.
# Prefer the DI_CONNECT folder; a parent that contains DI_CONNECT also works.
GARMIN_EXPORT_DIR=/path/to/DI_CONNECT

# Manual import is the default. Keep live Garmin private until the worker and
# authenticated deployment are ready.
GARMIN_LIVE_ENABLED=false

# Optional live Garmin Connect connector. Install it first from the repository root:
#   python3 -m pip install -e packages/garmin-connector
# Then enable it. The dashboard keeps manual export as a separate workflow.
# Optional override. If omitted, the backend runs the repository-local
# `.venv-garmin/bin/python -m garmin_connector` command automatically.
# GARMIN_CONNECTOR_COMMAND=garmin-connector

# Banister TRIMP athlete HR profile.
# Leave EMPTY to auto-fill from synced Garmin data.
ATHLETE_HR_REST=
ATHLETE_HR_MAX=
ATHLETE_SEX=male

# Local calendar for Daily Analyzer / activity day bucketing (IANA TZ).
ATHLETE_TIMEZONE=Asia/Jakarta
